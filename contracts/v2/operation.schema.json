{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paymentplan:operation:v2",
  "title": "PaymentPlan extension operation v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "vaultId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "entityId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "entityType": {
      "enum": [
        "category",
        "classification",
        "categoryRule",
        "categoryBudget",
        "recurrence",
        "occurrence",
        "cashAccount",
        "cashEntry",
        "savingsGoal",
        "savingsEntry"
      ]
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "deviceSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "parentRevisionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "dependencyOperationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      },
      "maxItems": 10000,
      "uniqueItems": true
    },
    "groupId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "groupIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "groupSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "action": {
      "enum": [
        "create",
        "replace",
        "void",
        "restore",
        "resolve"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "vaultId",
    "operationId",
    "entityId",
    "entityType",
    "deviceId",
    "deviceSequence",
    "parentRevisionIds",
    "dependencyOperationIds",
    "groupId",
    "groupIndex",
    "groupSize",
    "action",
    "updatedAt",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "create"
          }
        }
      },
      "then": {
        "properties": {
          "parentRevisionIds": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "parentRevisionIds": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "resolve"
          }
        }
      },
      "then": {
        "properties": {
          "parentRevisionIds": {
            "type": "array",
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "void"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          }
        }
      },
      "else": {
        "oneOf": [
          {
            "properties": {
              "entityType": {
                "const": "category"
              },
              "payload": {
                "$ref": "#/$defs/category"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "classification"
              },
              "payload": {
                "$ref": "#/$defs/classification"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "categoryRule"
              },
              "payload": {
                "$ref": "#/$defs/categoryRule"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "categoryBudget"
              },
              "payload": {
                "$ref": "#/$defs/categoryBudget"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "recurrence"
              },
              "payload": {
                "$ref": "#/$defs/recurrence"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "occurrence"
              },
              "payload": {
                "$ref": "#/$defs/occurrence"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "cashAccount"
              },
              "payload": {
                "$ref": "#/$defs/cashAccount"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "cashEntry"
              },
              "payload": {
                "$ref": "#/$defs/cashEntry"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "savingsGoal"
              },
              "payload": {
                "$ref": "#/$defs/savingsGoal"
              }
            }
          },
          {
            "properties": {
              "entityType": {
                "const": "savingsEntry"
              },
              "payload": {
                "$ref": "#/$defs/savingsEntry"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "groupId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "groupIndex": {
            "const": 0
          },
          "groupSize": {
            "const": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[0-9]{2}|[2-9][0-9]{3})-[0-9]{2}-[0-9]{2}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "signedMoney": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "color",
        "archived"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "movementId": {
          "$ref": "#/$defs/uuid"
        },
        "categoryId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "movementId",
        "categoryId"
      ]
    },
    "categoryRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "$ref": "#/$defs/uuid"
        },
        "cardId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "contains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "expense",
            "interest",
            "fee"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "categoryId",
        "cardId",
        "contains",
        "kind",
        "enabled"
      ]
    },
    "categoryBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categoryId": {
          "$ref": "#/$defs/uuid"
        },
        "payday": {
          "$ref": "#/$defs/date"
        },
        "limitCents": {
          "$ref": "#/$defs/money"
        }
      },
      "required": [
        "categoryId",
        "payday",
        "limitCents"
      ]
    },
    "recurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "$ref": "#/$defs/uuid"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "expense",
            "interest",
            "fee"
          ]
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "startDate": {
          "$ref": "#/$defs/date"
        },
        "endDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency": {
          "enum": [
            "weekly",
            "monthly",
            "paydays"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "categoryId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cardId",
        "description",
        "kind",
        "amountCents",
        "startDate",
        "endDate",
        "frequency",
        "enabled",
        "categoryId"
      ]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recurrenceId": {
          "$ref": "#/$defs/uuid"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "movementId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "recurrenceId",
        "date",
        "movementId"
      ]
    },
    "cashAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "cash",
            "debit"
          ]
        },
        "openingDate": {
          "$ref": "#/$defs/date"
        },
        "openingCents": {
          "$ref": "#/$defs/money"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "openingDate",
        "openingCents",
        "color",
        "archived"
      ]
    },
    "cashEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "$ref": "#/$defs/uuid"
        },
        "toAccountId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "cardMovementId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "income",
            "expense",
            "transfer",
            "cardPayment"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "categoryId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountId",
        "toAccountId",
        "cardMovementId",
        "date",
        "amountCents",
        "kind",
        "description",
        "categoryId"
      ]
    },
    "savingsGoal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "targetCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "targetDate": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "accountId",
        "name",
        "targetCents",
        "targetDate",
        "color",
        "archived"
      ]
    },
    "savingsEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goalId": {
          "$ref": "#/$defs/uuid"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "amountCents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "direction": {
          "enum": [
            "allocate",
            "release"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "required": [
        "goalId",
        "date",
        "amountCents",
        "direction",
        "description"
      ]
    }
  }
}
